---
export interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  label?: string;
  class?: string;
}

const {
  name,
  size = 20,
  strokeWidth = 1.75,
  label,
  class: className,
} = Astro.props;

// Static, Lucide-compatible line paths. Keeping the vocabulary local makes the
// docs deterministic and prevents animated product icons from leaking into
// explanatory content.
